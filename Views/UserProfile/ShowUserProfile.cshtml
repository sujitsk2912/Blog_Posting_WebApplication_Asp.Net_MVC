@{
    ViewBag.Title = "ShowUserProfile";
}


    <style>
        body {
            background-color: #000 !important;
            color: #fff;
        }

        .profile-header {
            display: flex;
            align-items: center;
            padding: 20px;
        }

        .profile-image {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 20px;
            border: 3px solid #007bff;
        }

        .profile-info {
            flex-grow: 1;
        }

        .stats {
            display: flex;
            gap: 20px;
        }

        .btn-follow {
            margin-right: 10px;
        }

        .posts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 10px;
            padding: 20px;
        }

        .post-item img {
            width: 100%;
            height: auto;
            border-radius: 10px;
            border: 2px solid #007bff;
        }

        h2, .stats span {
            text-shadow: 0 0 10px #007bff;
        }

        .btn-outline-light {
            border-color: #007bff;
            color: #007bff;
        }

            .btn-outline-light:hover {
                background-color: #007bff;
                color: #fff;
            }
        .not-found-title {
            line-height: 32px;
            font-size: 26px;
            font-weight: 600;
            word-break: break-word;
            white-space: pre-line;
            word-wrap: break-word;
        }
        .not-found-message {
            line-height: 28px;
            font-weight: 400;
            font-size: 18px;
            word-wrap: break-word;
            white-space: pre-line;
            word-break: break-word;
        }
    </style>


<main>

    <div class="container" style="min-height:80vh;">
        <!-- Profile Header -->
        <div class="profile-header">
            <img id="profileImage" src="https://picsum.photos/120/120?random=1" alt="Profile Image" class="profile-image">
            <div class="profile-info">
                <h2 id="fullName" class="fw-bold">Loading...</h2>
                <div class="stats">
                    <span><strong id="postsCount">0</strong> posts</span>
                    <span><strong id="followers">0</strong> followers</span>
                    <span><strong id="following">0</strong> following</span>
                </div>
                <button class="btn btn-outline-light btn-follow">Following</button>
                <button class="btn btn-outline-light">Message</button>
            </div>
        </div>

        <!-- Posts Section -->
        <div class="posts-grid">
            <div class="post-item">
                <img src="https://picsum.photos/300/300?random=2" alt="Post 1">
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/300/300?random=3" alt="Post 2">
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/300/300?random=4" alt="Post 3">
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/300/300?random=5" alt="Post 4">
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/300/300?random=6" alt="Post 5">
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/300/300?random=7" alt="Post 6">
            </div>
        </div>

        <!-- Not Found Section -->
        <div id="notFoundContainer" class="not-found-container" style="display: none;text-align:center">
            <span class="not-found-title">Sorry, this page isn't available.</span>
            <div class="not-found-message">
                The link you followed may be broken, or the page may have been removed.
                <a href="/Home" class="not-found-button text-decoration-none">Go back to Instagram</a>
            </div>
        </div>

    </div>
    
</main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Get the userId from the query string
            const urlParams = new URLSearchParams(window.location.search);
            const userId = urlParams.get('userId');

            if (userId) {
                // Fetch user profile data using AJAX
                $.ajax({
                    url: '/UserProfile/UserProfile',
                    type: 'POST',
                    data: { userId: userId },
                    success: function (response) {
                        if (response.success) {
                            const user = response.user;

                            // Update the profile header
                            $('#profileImage').attr('src', user.UserImage || 'https://picsum.photos/120/120?random=1');
                            $('#fullName').text(`${user.FirstName} ${user.LastName}`);
                            $('#postsCount').text(user.PostsCount);
                            $('#followers').text(user.Followers);
                            $('#following').text(user.Following);
                        } else {
                            // Show "Page Not Found" message
                            $('#notFoundContainer').show();
                            $('.profile-header').hide();
                            $('.posts-grid').hide();

                            // Apply CSS to the container
                            $('.container').css({
                                'place-content': 'center',
                            });

                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching user profile:", error);
                        alert('Error fetching user profile.');
                    }
                });
            } else {
                alert('User ID not found in the URL.');
            }
        });
    </script>


