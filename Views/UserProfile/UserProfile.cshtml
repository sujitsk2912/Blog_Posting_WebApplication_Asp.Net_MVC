
@{
    ViewBag.Title = "UserProfile";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #000 !important;
            color: #fff;
        }

        .profile-header {
            display: flex;
            align-items: center;
            padding: 20px;
        }

        .profile-image {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 20px;
            border: 3px solid #007bff;
        }

        .profile-info {
            flex-grow: 1;
        }

        .stats {
            display: flex;
            gap: 20px;
        }

        .btn-follow {
            margin-right: 10px;
        }

        .posts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 10px;
            padding: 20px;
        }

        .post-item img {
            width: 100%;
            height: auto;
            border-radius: 10px;
            border: 2px solid #007bff;
        }

        h2, .stats span {
            text-shadow: 0 0 10px #007bff;
        }

        .btn-outline-light {
            border-color: #007bff;
            color: #007bff;
        }

            .btn-outline-light:hover {
                background-color: #007bff;
                color: #fff;
            }
    </style>
</head>

<body>

    <div class="container">
        <!-- Profile Header -->
        <div class="profile-header">
            <img src="https://picsum.photos/120/120?random=1" alt="Profile Image" class="profile-image">
            <div class="profile-info">
                <h2 class="fw-bold">indiancricketteam</h2>
                <div class="stats">
                    <span><strong>15,133</strong> posts</span>
                    <span><strong>36.9M</strong> followers</span>
                    <span><strong>87</strong> following</span>
                </div>
                <button class="btn btn-outline-light btn-follow">Following</button>
                <button class="btn btn-outline-light">Message</button>
            </div>
        </div>

        <!-- Posts Section -->
        <div class="posts-grid">
            <div class="post-item">
                <img src="https://picsum.photos/300/300?random=2" alt="Post 1">
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/300/300?random=3" alt="Post 2">
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/300/300?random=4" alt="Post 3">
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/300/300?random=5" alt="Post 4">
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/300/300?random=6" alt="Post 5">
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/300/300?random=7" alt="Post 6">
            </div>
        </div>

    </div>

</body>

</html>
