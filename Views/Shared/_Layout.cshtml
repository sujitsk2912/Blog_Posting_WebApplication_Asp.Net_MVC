<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Poster</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- External CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" integrity="sha512-dPXYcDub/aeb08c63jRq/k6GaKccl256JQy/AnOq7CAnEZ9FzSL9wSbcZkMp4R26vBsMLFYH4kQ67/bbV8XaCQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- External JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!--<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>-->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Custom Styles -->
    <style>
        html, body {
            font-family: 'Poppins', sans-serif;
            background: #000;
            color: #fff;
            scrollbar-width: thin; /* For Firefox */
            scrollbar-color: #888 transparent;
        }
            /* For Chrome, Safari, and other WebKit-based browsers */
            body::-webkit-scrollbar {
                width: 10px; /* Set scrollbar width */
            }




        @@media (min-width: 576px) {
            .modal-dialog {
                max-width: 100% !important; /* Ensure full width */
                margin-right: auto;
                margin-left: auto;
            }
        }

        .bi-three-dots, h6 {
            color: #fff !important;
        }

        .card {
            background: transparent !important;
            border-bottom: 0.5px solid grey !important;
            padding: 20px 0 !important;
            border: 0.5px solid #262424 !important;
        }



        #getPostedOn {
            color: grey !important;
        }

        #getPostContent {
            color: #fff !important;
        }

        .search::placeholder {
            color: gray;
        }

        #search {
            min-width: 100%;
            color: #f5f5f5;
            border: none;
            border-radius: 50px;
            font-size: 15px;
            padding: 10px 25px;
            background-color: #363636;
        }

        .modal-content {
            background: #262626 !important;
        }
        /*        .modal-body a{
            text-align:center;
        }*/

        .modal-header {
            border: none;
            border-bottom: 1px solid #363636;
        }

        .modal-dialog {
            max-width: 500px;
        }

        .modal-header h5 {
            border: none;
            margin: 0;
            padding: 0;
            width: 100%;
            margin-top: 16px;
            align-items: stretch;
            border: 0;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            /*            flex-shrink: 0;*/
            font: inherit;
            font-size: 100%;
            /*            margin: 16px calc(2* 16px);*/
            word-wrap: anywhere;
            padding: 0;
            position: relative;
            text-align: center;
            vertical-align: baseline;
        }

        .modal-body {
            align-items: stretch;
            border: 0;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            font: inherit;
            font-size: 100%;
            margin: 0;
            /*            margin-top: 16px; */
            padding: 0;
            position: relative;
            vertical-align: baseline;
        }

            .modal-body button {
                font-weight: 600;
                background-color: transparent;
                border-bottom: 0;
                border-left: 0;
                border-right: 0;
                cursor: pointer;
                font-size: 15px;
                line-height: 1.5;
                margin: 0;
                min-height: 48px;
                padding: 4px 8px;
                text-align: center;
                -webkit-user-select: none;
                vertical-align: middle;
                border-top: 1px solid #363636;
                transition: 0.s all;
            }

                .modal-body button:hover {
                    background-color: #36363645 !important;
                }
    </style>

 
</head>
<body>
    <!-- Toast Container -->
    <div id="toastContainer" aria-live="polite" aria-atomic="true" class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <!-- Toasts will be dynamically inserted here -->
    </div>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark" style="position:sticky; top:0; z-index:999">
        <div class="container">
            @Html.ActionLink("Blog Poster", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Profile", "GetOurProfile", "UserProfile", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Logout", "Logout", "Account", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>
                <button class="form-control me-2 search" data-bs-toggle="modal" data-bs-target="#searchModal" type="button" placeholder="Search" aria-label="Search" style="color: #f5f5f5;width:fit-content; border: none; border-radius: 50px; font-size: 15px; padding: 10px 80px; background-color: #363636; ">Search Users</button>
            </div>
        </div>
    </nav>


    <div class="container body-content">
        <!-- Search User Modal -->

        <div class="modal fade modal-lg" id="searchModal" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
            <div class="modal-dialog" style="max-width:700px !important;margin-top:70px">
                <div class="modal-content" style="background: #000; color: #fff; border: 0.5px solid #262424 !important;">
                    <div class="modal-header" style="border-bottom: 1px solid #363636">
                        <input class="form-control me-2 search" id="search" oninput="searchUser()" type="text" placeholder="Search" autocomplete="off">
                        <button type="button" class="btn-close btn-close-white" style="position: absolute; right: -25px; top: -20px;" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" style="padding:20px">
                        <!-- Search results will be dynamically populated here -->
                    </div>
                </div>
            </div>
        </div>

        <!-- End Search User Modal -->
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script>
        $(document).ready(function () {
            // Handle logout link click
            $('a[href*="Logout"]').on('click', function (e) {
                e.preventDefault(); // Prevent the default link behavior

                Swal.fire({
                    title: 'Are you sure?',
                    text: 'You will be logged out!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, log me out!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Redirect to the logout action
                        window.location.href = '@Url.Action("Logout", "Account")';
                    }
                });
            });
        });
    </script>
    @*search user functionality*@

    <script>
        // Search function
        function searchUser() {
            // Get the search input element and value
            var searchInput = document.querySelector('#search');
            var searchTerm = searchInput ? searchInput.value.trim() : '';

            // Get the modal body
            var modalBody = document.querySelector('.modal-body');

            // Ensure searchTerm and modalBody exist
            if (!searchInput || !modalBody) {
                console.error('Search input or modal body not found.');
                return;
            }

            //console.log('Search term:', searchTerm); // Debugging output

            // Perform AJAX request to fetch users
            $.ajax({
                url: '/UserProfile/GetUsersByUsername',
                type: 'POST',
                data: { searchTerm: searchTerm },
                success: function (response) {
                    displayUsers(response);
                },
                error: function () {
                    modalBody.innerHTML = '<p>Error fetching user data.</p>';
                }
            });

            // Display users in the modal
            function displayUsers(users) {
                modalBody.innerHTML = '';

                if (!users || users.length === 0 || users[0].Message) {
                    modalBody.innerHTML = '<p>Users not found.</p>';
                    return;
                }

                users.forEach(function (user) {
                    var userItem = `
                                        <div class="user-item" style="padding: 10px; border-bottom: 1px solid #363636; display: flex; align-items: center; text-align: center;">
                                            <img  onclick="getUserProfile(${user.UserID})" src="${user.UserImageURL ? '/Assets/Images/' + user.UserImageURL : '/Assets/Images/user (13).png'}"
                                                 style="cursor:pointer;height:2.5rem;width:auto" class="rounded-circle me-3" alt="User Avatar">
                                            <div style="display: flex;flex-direction: column;text-align: start;">
                                                 <h6 onclick="getUserProfile(${user.UserID})"
                                                style="cursor:pointer; margin:0; font-size:15px;" class="mb-0">
                                                ${user.FirstName} ${user.LastName}
                                            </h6>
                                            <small  onclick="getUserProfile(${user.UserID})" style="cursor:pointer;font-size: 14px;color: grey;font-weight: 400;"> ${user.Username}</small>
                                            </div>
                                        </div>`;
                    modalBody.innerHTML += userItem;
                });
            }
        }

        // Clear search input and modal content when modal is closed
        document.getElementById('searchModal').addEventListener('hidden.bs.modal', function () {
            var searchInput = document.querySelector('#search');
            if (searchInput) searchInput.value = ''; // Clear input field
            var modalBody = document.querySelector('.modal-body');
            if (modalBody) modalBody.innerHTML = ''; // Clear search results
        });
    </script>



    @*end search user functionality*@


    @*funtion for redirecting on user profile*@
    <script>
        function getUserProfile(userId) {
            //const token = $('input[name="__RequestVerificationToken"]').val();

            //console.log("User ID:", userId);
            //console.log("Token:", token);

            $.ajax({
                url: '/UserProfile/UserProfile',
                type: 'POST',
                data: { userId: userId },
                //headers: {
                //    'RequestVerificationToken': token
                //},console.log
                //dataType: 'json', // Ensure the response is treated as JSON
                success: function (response) {
                    if (response.success) {
                        window.location.href = '/UserProfile/ShowUserProfile?userId=' + userId;

                    } else {
                        alert(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching user profile:", error);
                    alert('Error fetching user profile.');
                }
            });
        }

        // Call the function with the user ID
        //getUserProfile(123); // Replace 123 with the actual user ID you want to test with
    </script>

 
</body>

</html>